+
+/*
+AutoBleem: the pad's default keys for a player, instead of the keyboard's - OpenBOR's desktop defaults are the
+keyboard, so a pad did nothing until it was set up in a menu the pad could not reach. The PlayStation Classic
+port's layout (2019): Cross attack 1, Circle attack 2, Square attack 3, Triangle attack 4, L1 jump, R1 special,
+Start start, L2 the menu (Esc), Select screenshot; the D-pad moves. An input's number is OpenBOR's: after the
+pad's base, its buttons, then two per axis (negative, positive), then four per hat (up, right, down, left).
+Returns 0, leaving keys alone, when there is no such pad.
+*/
+#ifdef _WIN32
+// Windows has no virtual pad: SDL's own mapping of the pad says where each button is
+static int pad_bind_key(SDL_GameControllerButtonBind bind, int base, int buttons, int axes, int positive)
+{
+    switch (bind.bindType)
+    {
+    case SDL_CONTROLLER_BINDTYPE_BUTTON:
+        return base + bind.value.button;
+    case SDL_CONTROLLER_BINDTYPE_AXIS:
+        return base + buttons + 2 * bind.value.axis + (positive ? 1 : 0);
+    case SDL_CONTROLLER_BINDTYPE_HAT:
+        return base + buttons + 2 * axes + 4 * bind.value.hat.hat +
+               ((bind.value.hat.hat_mask & SDL_HAT_UP) ? 0 : (bind.value.hat.hat_mask & SDL_HAT_RIGHT) ? 1 :
+                (bind.value.hat.hat_mask & SDL_HAT_DOWN) ? 2 : 3);
+    default:
+        return CONTROL_NONE;
+    }
+}
+#endif
+
+int control_pad_default_keys(int pad, int *keys)
+{
+    int base, buttons, axes;
+    if (pad < 0 || pad >= JOY_LIST_TOTAL)
+    {
+        return 0;
+    }
+    base = JOY_LIST_FIRST + 1 + pad * JOY_MAX_INPUTS;
+#ifdef _WIN32
+    if (joystick[pad] == NULL)
+    {
+        return 0;
+    }
+    buttons = joysticks[pad].NumButtons;
+    axes = joysticks[pad].NumAxes;
+    {
+        SDL_GameController *gc = SDL_IsGameController(pad) ? SDL_GameControllerOpen(pad) : NULL;
+        if (gc == NULL)
+        {
+            return 0;
+        }
+        keys[SDID_MOVEUP]     = pad_bind_key(SDL_GameControllerGetBindForButton(gc, SDL_CONTROLLER_BUTTON_DPAD_UP), base, buttons, axes, 0);
+        keys[SDID_MOVEDOWN]   = pad_bind_key(SDL_GameControllerGetBindForButton(gc, SDL_CONTROLLER_BUTTON_DPAD_DOWN), base, buttons, axes, 1);
+        keys[SDID_MOVELEFT]   = pad_bind_key(SDL_GameControllerGetBindForButton(gc, SDL_CONTROLLER_BUTTON_DPAD_LEFT), base, buttons, axes, 0);
+        keys[SDID_MOVERIGHT]  = pad_bind_key(SDL_GameControllerGetBindForButton(gc, SDL_CONTROLLER_BUTTON_DPAD_RIGHT), base, buttons, axes, 1);
+        keys[SDID_ATTACK]     = pad_bind_key(SDL_GameControllerGetBindForButton(gc, SDL_CONTROLLER_BUTTON_A), base, buttons, axes, 1);
+        keys[SDID_ATTACK2]    = pad_bind_key(SDL_GameControllerGetBindForButton(gc, SDL_CONTROLLER_BUTTON_B), base, buttons, axes, 1);
+        keys[SDID_ATTACK3]    = pad_bind_key(SDL_GameControllerGetBindForButton(gc, SDL_CONTROLLER_BUTTON_X), base, buttons, axes, 1);
+        keys[SDID_ATTACK4]    = pad_bind_key(SDL_GameControllerGetBindForButton(gc, SDL_CONTROLLER_BUTTON_Y), base, buttons, axes, 1);
+        keys[SDID_JUMP]       = pad_bind_key(SDL_GameControllerGetBindForButton(gc, SDL_CONTROLLER_BUTTON_LEFTSHOULDER), base, buttons, axes, 1);
+        keys[SDID_SPECIAL]    = pad_bind_key(SDL_GameControllerGetBindForButton(gc, SDL_CONTROLLER_BUTTON_RIGHTSHOULDER), base, buttons, axes, 1);
+        keys[SDID_START]      = pad_bind_key(SDL_GameControllerGetBindForButton(gc, SDL_CONTROLLER_BUTTON_START), base, buttons, axes, 1);
+        keys[SDID_SCREENSHOT] = pad_bind_key(SDL_GameControllerGetBindForButton(gc, SDL_CONTROLLER_BUTTON_BACK), base, buttons, axes, 1);
+        keys[SDID_ESC]        = pad_bind_key(SDL_GameControllerGetBindForAxis(gc, SDL_CONTROLLER_AXIS_TRIGGERLEFT), base, buttons, axes, 1);
+        SDL_GameControllerClose(gc);
+    }
+#else
+    // the virtual pad in its PlayStation Classic layout (the App's pad.ini says virtual = psc): Triangle 0,
+    // Circle 1, Cross 2, Square 3, L2 4, R2 5, L1 6, R1 7, Select 8, Start 9, the D-pad on axes 0 and 1. The
+    // layout is fixed, so the codes are too: they do not wait for the pad to be open - the game list reads its
+    // settings before it is - just as the 2019 PlayStation Classic port set them
+    buttons = 10;
+    axes = 2;
+    keys[SDID_MOVEUP]     = base + buttons + 2 * 1;
+    keys[SDID_MOVEDOWN]   = base + buttons + 2 * 1 + 1;
+    keys[SDID_MOVELEFT]   = base + buttons;
+    keys[SDID_MOVERIGHT]  = base + buttons + 1;
+    keys[SDID_ATTACK]     = base + 2;
+    keys[SDID_ATTACK2]    = base + 1;
+    keys[SDID_ATTACK3]    = base + 3;
+    keys[SDID_ATTACK4]    = base + 0;
+    keys[SDID_JUMP]       = base + 6;
+    keys[SDID_SPECIAL]    = base + 7;
+    keys[SDID_START]      = base + 9;
+    keys[SDID_SCREENSHOT] = base + 8;
+    keys[SDID_ESC]        = base + 4;
+#endif
+    return 1;
+}
